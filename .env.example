# SentientShield Environment Configuration

# API Security
JWT_SECRET=your-secure-jwt-secret-here
JWT_ALG=HS256
TRUSTED_ORIGINS=http://localhost:8000,http://localhost:3000

# HuggingFace Hub Integration
HF_HUB_REPO_ID=DhruveshBhamare/SentientShield-ML-Model
HF_TOKEN=your-huggingface-token-here (optional for public repos)

# AI Models (NVIDIA AI Foundation)
NVIDIA_API_KEY=your-nvidia-api-key-here
NVIDIA_MODEL=qwen/qwen3.5-397b-a17b

# Database (Optional for production)
DATABASE_URL=postgresql://user:password@localhost:5432/sentientshield

# Deployment Settings
PORT=10000
PYTHON_VERSION=3.10.0
RETRAIN_INTERVAL_SECONDS=86400
API_URL=http://localhost:10000
